{
  "scopeName": "source.ebasm",
  "patterns": [
    { "include": "#instructions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "instructions": {
      "patterns": [
        {
          "match": "\\b(push|plus|minus|mult|div|jmp|hlt|drop|jnz|teq|dump|dup|nop)\\b",
          "name": "keyword.control.ebasm"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0x[0-9A-Fa-f]+|\\d+)\\b",
          "name": "constant.numeric.ebasm"
        }
      ]
    }
  }
}