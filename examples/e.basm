# sum (1/n!)
# 1/1 + 1/1 + 1(1 * 2) + 1(1 * 2 * 3) + ...
    push 1.0f64     # n
    push 1.0f64     # n!
    push 1.0f64     # sum
loop:
    push 1.0f64
    dup 2
    divf
    plusf 

    swap 2
    push 1.0f64
    plusf
    dup 0
    swap 2
    multf

    swap 1
    swap 2

    dup 2
    push 69f64
    gef

    jmt loop

    native 4        # print f64
    
    drop
    drop
    hlt