        jmp main
        # 1477 is the maximum iteration number that its fib is not infinity
main:        
        push 1477               # counter
        # first two fibonacci numbers
        push 0.0                # fib_2
        push 1.0                # fib_1
loop:   swap 1
        dup 0
        native 4
        dup 1
        addf
        swap 2
        push 1
        subi
        dup 0
        swap 3
        swap 1
        jmt loop
        hlt