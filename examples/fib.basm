        jmp main
main:
        # 1477 is the maximum iteration number that its fib is not infinity
        push 1477               # counter
        # first two fibonacci numbers
        push 0f64               # fib_2
        push 1f64               # fib_1
loop:   swap 1
        dup 0
        native 4
        dup 1
        plusf
        swap 2
        push 1
        minusi
        dup 0
        swap 3
        swap 1
        jmt loop
        hlt