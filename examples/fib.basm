# 1477 is the maximum iteration number that its fib is not infinity
%bind count 1477
%bind a 0
%bind b 1
%bind c 2
%bind d 3

        jmp main
main:        
        push count               # counter
        # first two fibonacci numbers
        push 0.0                # fib_2
        push 1.0                # fib_1
loop:   swap b
        dup a
        native 4
        dup b
        addf
        swap c
        push b
        subi
        dup a
        swap d
        swap b
        jmt loop
        hlt