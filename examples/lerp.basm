    jmp main

# a
# b
# t
# --
# a + (b - a) * t
lerpf:
    swap 3
    dup 0
    swap 3
    swap 1
    minusf
    multf
    addf
    swap 1
    ret

main:
    push 69f64
    push 420f64
    push 1f64

loop:

    dup 2
    dup 2
    dup 2
    call lerpf
    native 4
    
    push 0f64
    dup 1
    gef
    jmt end

    push 0.01f64
    minusf
    
    jmp loop

end:
    hlt