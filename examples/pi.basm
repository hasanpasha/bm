# Leibniz formula for π
# n = (4/1) - (4/3) + (4/5) - (4/7) + (4/9) - (4/11) + (4/13) ...
# Take 4 and subtract 4 divided by 3. then add 4 diveded by 5.
# Then subtract 4 divided by 7. continue alternating between adding
# and subrtacting fractions with a numerator of 4 and denominator of
# each subsequent odd number. The more times you do this, the closer
# you will get to pi.

    push 4f64               # acc (result of first division)
    push 3f64               # denominator
    push 750000             # counter

loop:
    swap 2              # swap counter (top of stack) with current acc

    # calculate next denominator
    push 4f64
    dup 2
    push 2f64
    plusf
    swap 3

    # calculate with current denominator
    divf                #       (4/n)
    minusf              # acc - ^

    # calculate next denominator
    push 4f64
    dup 2
    push 2f64
    plusf
    swap 3

    # calculate with next denominator
    divf                #       (4/n)
    plusf               # acc + ^

    # decrement counter 
    swap 2
    push 1
    minusi

    dup 0               # duplicate current counter since jt consumes top of stack
    jt  loop

    drop                # drop counter
    drop                # drop denominator

    # only pi remains on the stack
    native 2
    drop

    hlt