{
  "scopeName": "source.basm",
  "patterns": [
    { "include": "#instructions" },
    { "include": "#numbers" },
    { "include": "#comments" },
    { "include": "#labels" }
  ],
  "repository": {
    "instructions": {
      "match": "\\b(push|plusi|minusi|multi|divi|plusf|minusf|multf|divf|jmp|call|ret|jt|hlt|drop|eq|dup|nop|swap|not|gef)\\b",
      "name": "keyword.control.basm"
    },
    "numbers": {
      "match": "\\b(?:\\d+\\.\\d*|\\.\\d+|\\d+[eE][+-]?\\d+|\\d+)(?:i64|u64|f64)?\\b",
      "name": "constant.numeric.basm"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.hash.basm"
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(:)",
          "captures": {
            "1": { "name": "entity.name.label.basm" },
            "2": { "name": "punctuation.separator.label.basm" }
          }
        },
        {
          "match": "\\b(?<=jmp\\s|jt\\s|call\\s)[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "entity.name.label.basm"
        }
      ]
    }
  }
}