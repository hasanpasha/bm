    jmp main

# a
# b
# t
# --
# a + (b - a) * t
lerpf:
    swap 3
    dup 0
    swap 3
    swap 1
    subf
    multf
    addf
    swap 1
    ret

main:
    push 69.0
    push 420.0
    push 1.0

loop:

    dup 2
    dup 2
    dup 2
    call lerpf
    native 4
    
    push 0.0
    dup 1
    gef
    jmt end

    push 0.01
    subf
    
    jmp loop

end: 
    hlt